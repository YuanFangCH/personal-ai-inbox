<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/section_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/home_widget_section_light"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/section_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/home_widget_text_primary_light"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/section_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/home_widget_text_secondary_light"
        android:textSize="10sp" />
</LinearLayout>
