<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_widget_background_light"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.58"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/home_widget_title"
            android:textColor="@color/home_widget_text_primary_light"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/home_widget_text_secondary_light"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fixed_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/home_widget_surface_light"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/fixed_row_0_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_widget_text_primary_light"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fixed_row_0_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="0.42"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_widget_text_secondary_light"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fixed_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/home_widget_surface_light"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/fixed_row_1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.58"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_widget_text_primary_light"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fixed_row_1_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="0.42"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_widget_text_secondary_light"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fixed_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/home_widget_surface_light"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/fixed_row_2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.58"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_widget_text_primary_light"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fixed_row_2_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="0.42"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_widget_text_secondary_light"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fixed_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/home_widget_surface_light"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/fixed_row_3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.58"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_widget_text_primary_light"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fixed_row_3_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="0.42"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_widget_text_secondary_light"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fixed_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/home_widget_surface_light"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/fixed_row_4_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.58"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_widget_text_primary_light"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fixed_row_4_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="0.42"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_widget_text_secondary_light"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fixed_row_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/home_widget_surface_light"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/fixed_row_5_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.58"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_widget_text_primary_light"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fixed_row_5_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="0.42"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_widget_text_secondary_light"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/fixed_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/home_widget_text_secondary_light"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/fixed_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/home_widget_accent_light"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
